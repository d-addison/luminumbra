# Forge local environment for Luminumbra (a C++ project)
#
# Source this before any `forge contracts execute` run. PowerShell:
#   Get-Content .forge/env.local.example | ForEach-Object {
#     if ($_ -match '^([A-Z_][A-Z0-9_]*)=(.*)$') { Set-Item -Path "env:$($Matches[1])" -Value $Matches[2] }
#   }
# Or copy to .forge/env.local and source via your shell of choice.

# Disable Forge's post-cherry-pick `cargo check` integration step.
# Luminumbra is C++; there is no Cargo.toml. Without this, every successful
# task gets reverted because cargo check fails with "could not find Cargo.toml".
# Once upstream Forge auto-detects this from polyglot.json (see audit notes),
# this var can be removed.
FORGE_INTEGRATION_CARGO_CHECK=0

# Disable Forge's post-cherry-pick hygiene auto-fix (cargo-fmt etc.).
# Same Rust assumption; same workaround.
FORGE_INTEGRATION_HYGIENE=0

include_guard(GLOBAL)

if(WIN32 AND (LUMINUMBRA_ENABLE_GNS OR LUMINUMBRA_ENABLE_STEAM)
   AND CMAKE_VERSION VERSION_LESS 3.21)
    message(FATAL_ERROR
        "Networked Windows builds (LUMINUMBRA_ENABLE_GNS or LUMINUMBRA_ENABLE_STEAM) require CMake 3.21+ for runtime DLL staging. Upgrade CMake or disable both networking backends.")
endif()

function(luminumbra_network_configurations OUT_VAR)
    get_property(_multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
    if(_multi_config)
        set(_configs ${CMAKE_CONFIGURATION_TYPES})
    elseif(CMAKE_BUILD_TYPE)
        set(_configs "${CMAKE_BUILD_TYPE}")
    else()
        set(_configs NOCONFIG)
    endif()
    set(${OUT_VAR} "${_configs}" PARENT_SCOPE)
endfunction()

function(luminumbra_network_imported_files OUT_LOCATION OUT_IMPLIB TARGET_NAME CONFIG)
    # Mirror imported-target selection for both DLLs and import libraries. A
    # mapping is authoritative; an empty mapped entry selects the generic files.
    set(${OUT_LOCATION} "" PARENT_SCOPE)
    set(${OUT_IMPLIB} "" PARENT_SCOPE)
    get_target_property(_type ${TARGET_NAME} TYPE)
    if(_type STREQUAL "INTERFACE_LIBRARY")
        return()
    endif()
    string(TOUPPER "${CONFIG}" _config)
    get_property(_mapped_set TARGET ${TARGET_NAME} PROPERTY MAP_IMPORTED_CONFIG_${_config} SET)
    if(_mapped_set)
        get_target_property(_mapped ${TARGET_NAME} MAP_IMPORTED_CONFIG_${_config})
        set(_properties "")
        if("${_mapped}" STREQUAL "")
            list(APPEND _properties IMPORTED_LOCATION)
        else()
            foreach(_candidate IN LISTS _mapped)
                if("${_candidate}" STREQUAL "")
                    list(APPEND _properties IMPORTED_LOCATION)
                else()
                    string(TOUPPER "${_candidate}" _candidate)
                    list(APPEND _properties "IMPORTED_LOCATION_${_candidate}")
                endif()
            endforeach()
        endif()
    else()
        set(_properties "IMPORTED_LOCATION_${_config}" IMPORTED_LOCATION)
        get_target_property(_available ${TARGET_NAME} IMPORTED_CONFIGURATIONS)
        if(_available)
            foreach(_candidate IN LISTS _available)
                string(TOUPPER "${_candidate}" _candidate)
                list(APPEND _properties "IMPORTED_LOCATION_${_candidate}")
            endforeach()
        endif()
    endif()
    foreach(_property IN LISTS _properties)
        string(REPLACE IMPORTED_LOCATION IMPORTED_IMPLIB _implib_property "${_property}")
        get_target_property(_location ${TARGET_NAME} ${_property})
        get_target_property(_implib ${TARGET_NAME} ${_implib_property})
        if(_location OR _implib)
            # A selected configuration can supply just one of the pair; CMake
            # fills the other from the configuration-independent property.
            if(NOT _location)
                get_target_property(_location ${TARGET_NAME} IMPORTED_LOCATION)
            endif()
            if(NOT _implib)
                get_target_property(_implib ${TARGET_NAME} IMPORTED_IMPLIB)
            endif()
            if(_location)
                set(${OUT_LOCATION} "${_location}" PARENT_SCOPE)
            endif()
            if(_implib)
                set(${OUT_IMPLIB} "${_implib}" PARENT_SCOPE)
            endif()
            return()
        endif()
    endforeach()
    if(_mapped_set)
        message(FATAL_ERROR "GNS imported target ${TARGET_NAME} has no files matching MAP_IMPORTED_CONFIG_${_config} (${_mapped}) for ${CONFIG}")
    endif()
endfunction()

function(luminumbra_network_search_dirs OUT_VAR DIRECTORY CONFIG)
    get_filename_component(_dir "${DIRECTORY}" ABSOLUTE)
    set(_dirs "${_dir}")
    set(_subdir "")
    while(TRUE)
        get_filename_component(_part "${_dir}" NAME)
        get_filename_component(_parent "${_dir}" DIRECTORY)
        string(TOLOWER "${_part}" _part_lower)
        if(_part_lower STREQUAL "bin")
            # The original bin directory already identifies the configuration.
            break()
        elseif(_part_lower MATCHES "^(lib|lib32|lib64|share)$")
            set(_bin "${_parent}/bin")
            if(_part_lower STREQUAL "share" OR _subdir MATCHES "(^|/)cmake(/|$)")
                # CONFIG metadata is configuration-independent. Prefer the
                # debug package bin only when no imported file supplied a root.
                string(TOUPPER "${CONFIG}" _config)
                if(_config STREQUAL "DEBUG" AND IS_DIRECTORY "${_parent}/debug/bin")
                    set(_bin "${_parent}/debug/bin")
                endif()
            elseif(_subdir AND IS_DIRECTORY "${_bin}/${_subdir}")
                set(_bin "${_bin}/${_subdir}")
            endif()
            list(APPEND _dirs "${_bin}")
            break()
        endif()
        if(_dir STREQUAL _parent)
            break()
        endif()
        if(_subdir)
            set(_subdir "${_part}/${_subdir}")
        else()
            set(_subdir "${_part}")
        endif()
        set(_dir "${_parent}")
    endwhile()
    set(${OUT_VAR} "${_dirs}" PARENT_SCOPE)
endfunction()

function(luminumbra_collect_gns_runtime_search_dirs)
    # Capture each configuration in the package's directory scope: imported
    # targets need not be GLOBAL, and package variables are local to GNS.
    luminumbra_network_configurations(_configs)
    foreach(_config IN LISTS _configs)
        string(TOUPPER "${_config}" _config_key)
        set(_search_dirs "")
        set(_package_dlls "")
        set(_openssl_dirs "")
        foreach(_target IN ITEMS protobuf::libprotobuf absl::base OpenSSL::Crypto OpenSSL::SSL)
            if(NOT TARGET ${_target})
                continue()
            endif()
            luminumbra_network_imported_files(_location _implib ${_target} "${_config}")
            set(_target_dirs "")
            # A DLL location is authoritative. Its generic import library may
            # live in a different configuration's tree and must not seed it.
            set(_file "${_location}")
            if(NOT _file)
                set(_file "${_implib}")
            endif()
            if(_file)
                get_filename_component(_dir "${_file}" DIRECTORY)
                luminumbra_network_search_dirs(_target_dirs "${_dir}" "${_config}")
            endif()
            if(NOT _target_dirs)
                if(_target MATCHES "^protobuf::")
                    set(_package_dir "${Protobuf_DIR}")
                elseif(_target MATCHES "^absl::")
                    set(_package_dir "${absl_DIR}")
                else()
                    set(_package_dir "${OpenSSL_DIR}")
                endif()
                if(_package_dir)
                    luminumbra_network_search_dirs(_target_dirs "${_package_dir}" "${_config}")
                endif()
            endif()
            list(APPEND _search_dirs ${_target_dirs})
            if(_location MATCHES "[.][Dd][Ll][Ll]$")
                list(APPEND _package_dlls "${_location}")
            endif()
            if(_target MATCHES "^OpenSSL::")
                list(APPEND _openssl_dirs ${_target_dirs})
            endif()
        endforeach()
        list(REMOVE_DUPLICATES _search_dirs)
        list(REMOVE_DUPLICATES _package_dlls)
        list(REMOVE_DUPLICATES _openssl_dirs)
        set_property(TARGET luminumbra_common PROPERTY LUMINUMBRA_NETWORK_RUNTIME_DIRS_${_config_key} "${_search_dirs}")
        set_property(TARGET luminumbra_common PROPERTY LUMINUMBRA_NETWORK_PACKAGE_DLLS_${_config_key} "${_package_dlls}")
        set_property(TARGET luminumbra_common PROPERTY LUMINUMBRA_NETWORK_OPENSSL_DIRS_${_config_key} "${_openssl_dirs}")
    endforeach()
endfunction()

function(luminumbra_require_network_dll OUT_VAR DLL_NAME)
    foreach(_bin IN LISTS ARGN)
        if(EXISTS "${_bin}/${DLL_NAME}" AND NOT IS_DIRECTORY "${_bin}/${DLL_NAME}")
            set(${OUT_VAR} "${_bin}/${DLL_NAME}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "GNS runtime DLL ${DLL_NAME} was not found in the compiler/package bin directories: ${ARGN}")
endfunction()

function(luminumbra_collect_absl_runtime OUT_VAR CONFIG)
    set(_bins ${ARGN})
    set(_imported_dlls "")
    get_property(_targets DIRECTORY PROPERTY IMPORTED_TARGETS)
    list(APPEND _targets absl::base)
    list(REMOVE_DUPLICATES _targets)
    foreach(_target IN LISTS _targets)
        if(NOT _target MATCHES "^absl::" OR NOT TARGET ${_target})
            continue()
        endif()
        luminumbra_network_imported_files(_location _implib ${_target} "${CONFIG}")
        get_filename_component(_name "${_location}" NAME)
        if(_name MATCHES "^libabsl_.*[.]dll$")
            if(NOT EXISTS "${_location}" OR IS_DIRECTORY "${_location}")
                message(FATAL_ERROR "GNS Abseil imported runtime DLL is missing for ${CONFIG}: ${_location}")
            endif()
            list(APPEND _imported_dlls "${_location}")
            get_filename_component(_bin "${_location}" DIRECTORY)
            list(PREPEND _bins "${_bin}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _bins)
    set(_available_dlls ${_imported_dlls})
    set(_fallback_dlls "")
    foreach(_bin IN LISTS _bins)
        file(GLOB _dlls LIST_DIRECTORIES FALSE CONFIGURE_DEPENDS "${_bin}/libabsl_*.dll")
        list(APPEND _available_dlls ${_dlls})
        if(NOT _fallback_dlls AND _dlls)
            set(_fallback_dlls ${_dlls})
        endif()
    endforeach()
    if(NOT _available_dlls)
        message(FATAL_ERROR "GNS requires Abseil runtime DLLs (libabsl_*.dll); none found in imported targets or package/compiler bin directories: ${_bins}")
    endif()
    # Inspect all candidate directories for this configuration, even when
    # metadata selects a DLL, so mixed package versions cannot be preferred.
    set(_versions "")
    foreach(_dll IN LISTS _available_dlls)
        get_filename_component(_name "${_dll}" NAME)
        if(_name MATCHES "-([0-9][0-9.]*)[.]dll$")
            list(APPEND _versions "${CMAKE_MATCH_1}")
        else()
            list(APPEND _versions unversioned)
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _versions)
    list(LENGTH _versions _version_count)
    if(_version_count GREATER 1)
        message(FATAL_ERROR "GNS found multiple distinct Abseil DLL versions (${_versions}) in: ${_bins}. Remove stale DLLs or use one consistent package installation.")
    endif()
    if(_imported_dlls)
        set(_dlls ${_imported_dlls})
    else()
        set(_dlls ${_fallback_dlls})
    endif()
    list(REMOVE_DUPLICATES _dlls)
    set(${OUT_VAR} "${_dlls}" PARENT_SCOPE)
endfunction()

function(luminumbra_network_mingw_compiler_dlls OUT_VAR COMPILER_BIN)
    if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        set(_names libc++.dll libunwind.dll libwinpthread-1.dll)
    else()
        set(_names libgcc_s_seh-1.dll libstdc++-6.dll libwinpthread-1.dll)
    endif()
    set(_dlls "")
    foreach(_name IN LISTS _names)
        if(EXISTS "${COMPILER_BIN}/${_name}" AND NOT IS_DIRECTORY "${COMPILER_BIN}/${_name}")
            list(APPEND _dlls "${COMPILER_BIN}/${_name}")
        endif()
    endforeach()
    # Seed available compiler DLLs for direct executable imports as well as
    # dependency imports. The PE scanner rejects missing imported runtimes;
    # unimported runtimes (including optional winpthreads) need not be installed.
    set(${OUT_VAR} "${_dlls}" PARENT_SCOPE)
endfunction()

function(luminumbra_collect_gns_mingw_runtime)
    file(REAL_PATH "${CMAKE_CXX_COMPILER}" _compiler_path)
    get_filename_component(_compiler_bin "${_compiler_path}" DIRECTORY)
    # Imported targets can omit DLL locations and dependencies present only in
    # import tables. Use only the selected configuration's package directories.
    luminumbra_network_configurations(_configs)
    foreach(_config IN LISTS _configs)
        string(TOUPPER "${_config}" _config_key)
        get_target_property(_package_dirs luminumbra_common LUMINUMBRA_NETWORK_RUNTIME_DIRS_${_config_key})
        set(_runtime_dlls "")
        foreach(_name IN ITEMS libprotobuf.dll libutf8_validity.dll zlib1.dll libcrypto-3-x64.dll)
            luminumbra_require_network_dll(_dll "${_name}" ${_package_dirs} "${_compiler_bin}")
            list(APPEND _runtime_dlls "${_dll}")
        endforeach()
        luminumbra_collect_absl_runtime(_absl_dlls "${_config}" ${_package_dirs} "${_compiler_bin}")
        list(APPEND _runtime_dlls ${_absl_dlls})
        luminumbra_network_mingw_compiler_dlls(_compiler_dlls "${_compiler_bin}")
        list(APPEND _runtime_dlls ${_compiler_dlls})
        list(REMOVE_DUPLICATES _runtime_dlls)
        set_property(TARGET luminumbra_common PROPERTY LUMINUMBRA_GNS_RUNTIME_DLLS_${_config_key} "${_runtime_dlls}")
    endforeach()
endfunction()

function(luminumbra_stage_networking_runtime)
    if(NOT LUMINUMBRA_ENABLE_GNS AND NOT LUMINUMBRA_ENABLE_STEAM)
        return()
    endif()
    set(_apps ${ARGN})
    get_property(_multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
    set(_runtime_dir "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")
    if(_multi_config)
        string(APPEND _runtime_dir "/$<CONFIG>")
    endif()
    set(_stamp "${CMAKE_CURRENT_BINARY_DIR}/network-runtime/$<CONFIG>/staged.stamp")
    if(WIN32)
        file(REAL_PATH "${CMAKE_CXX_COMPILER}" _compiler_path)
        get_filename_component(_compiler_bin "${_compiler_path}" DIRECTORY)
        set(_search_dirs "${_compiler_bin}")
        set(_extra_dlls "")
        if(LUMINUMBRA_ENABLE_GNS)
            luminumbra_network_configurations(_configs)
            foreach(_config IN LISTS _configs)
                string(TOUPPER "${_config}" _config_key)
                if(NOT _multi_config AND NOT CMAKE_BUILD_TYPE)
                    set(_condition "$<STREQUAL:$<CONFIG>,>")
                else()
                    set(_condition "$<CONFIG:${_config}>")
                endif()
                get_target_property(_package_dirs luminumbra_common LUMINUMBRA_NETWORK_RUNTIME_DIRS_${_config_key})
                foreach(_dir IN LISTS _package_dirs)
                    list(APPEND _search_dirs "$<${_condition}:${_dir}>")
                endforeach()
                if(MINGW)
                    get_target_property(_config_dlls luminumbra_common LUMINUMBRA_GNS_RUNTIME_DLLS_${_config_key})
                else()
                    get_target_property(_config_dlls luminumbra_common LUMINUMBRA_NETWORK_PACKAGE_DLLS_${_config_key})
                    get_target_property(_openssl_dirs luminumbra_common LUMINUMBRA_NETWORK_OPENSSL_DIRS_${_config_key})
                    # FindOpenSSL may expose only UNKNOWN import-library targets.
                    # Glob only their selected configuration's runtime roots.
                    foreach(_dir IN LISTS _openssl_dirs)
                        file(GLOB _crypto_dlls LIST_DIRECTORIES FALSE CONFIGURE_DEPENDS
                            "${_dir}/*crypto*.dll" "${_dir}/*ssl*.dll")
                        list(APPEND _config_dlls ${_crypto_dlls})
                    endforeach()
                endif()
                list(REMOVE_DUPLICATES _config_dlls)
                foreach(_dll IN LISTS _config_dlls)
                    list(APPEND _extra_dlls "$<${_condition}:${_dll}>")
                endforeach()
            endforeach()
        else()
            list(APPEND _search_dirs "${LUMINUMBRA_STEAM_SDK_DIR}/redistributable_bin/win64")
            list(APPEND _extra_dlls "$<TARGET_FILE:luminumbra_steam_api>")
        endif()
        if(MINGW)
            # Executables can import compiler runtimes directly, even if none
            # of the supplemental dependency DLLs import them (notably Steam).
            luminumbra_network_mingw_compiler_dlls(_compiler_dlls "${_compiler_bin}")
            list(APPEND _extra_dlls ${_compiler_dlls})
        elseif(MSVC)
            # Discover redistributables without adding install rules. Include
            # debug runtimes for build-tree previews with multi-config builds.
            set(CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP TRUE)
            set(CMAKE_INSTALL_DEBUG_LIBRARIES TRUE)
            include(InstallRequiredSystemLibraries)
            list(APPEND _extra_dlls ${CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS})
            foreach(_dll IN LISTS CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS)
                get_filename_component(_dir "${_dll}" DIRECTORY)
                list(APPEND _search_dirs "${_dir}")
            endforeach()
        endif()
        list(REMOVE_DUPLICATES _search_dirs)
        list(REMOVE_DUPLICATES _extra_dlls)
        set(_target_dlls "")
        foreach(_app IN LISTS _apps)
            list(APPEND _target_dlls "$<TARGET_RUNTIME_DLLS:${_app}>")
        endforeach()
        # Keep executable target expressions out of the staging command: using
        # TARGET_FILE here would add a reverse dependency and create a cycle.
        set(_inputs "${CMAKE_CURRENT_BINARY_DIR}/network-runtime/$<CONFIG>/inputs.txt")
        file(GENERATE OUTPUT "${_inputs}"
            CONTENT "$<JOIN:${_target_dlls};${_extra_dlls},\n>\n")
        set(_helper "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/copy_networking_runtime.cmake")
        # One owner per configuration. Running on each requested build also
        # repairs deleted DLLs and observes dependencies found only by scanning.
        add_custom_target(luminumbra_network_runtime
            COMMAND ${CMAKE_COMMAND}
                "-DNETWORK_INPUT_FILE=${_inputs}"
                "-DNETWORK_CONFIG=$<CONFIG>"
                "-DNETWORK_RUNTIME_DIR=${_runtime_dir}"
                "-DNETWORK_STAMP=${_stamp}"
                "-DNETWORK_SEARCH_DIRS=${_search_dirs}"
                "-DNETWORK_OBJDUMP=${CMAKE_OBJDUMP}"
                "-DNETWORK_DUMPBIN=${CMAKE_DUMPBIN}"
                -P "${_helper}"
            BYPRODUCTS "${_stamp}"
            DEPENDS "${_inputs}" "${_helper}" ${_target_dlls} ${_extra_dlls}
            COMMENT "Staging shared networking runtime DLLs"
            VERBATIM)
        foreach(_app IN LISTS _apps)
            add_dependencies(${_app} luminumbra_network_runtime)
            add_custom_command(TARGET ${_app} POST_BUILD
                COMMAND ${CMAKE_COMMAND}
                    "-DNETWORK_EXECUTABLE=$<TARGET_FILE:${_app}>"
                    "-DNETWORK_INPUT_FILE=${_inputs}"
                    "-DNETWORK_CONFIG=$<CONFIG>"
                    "-DNETWORK_RUNTIME_DIR=$<TARGET_FILE_DIR:${_app}>"
                    "-DNETWORK_SEARCH_DIRS=${_search_dirs}"
                    "-DNETWORK_OBJDUMP=${CMAKE_OBJDUMP}"
                    "-DNETWORK_DUMPBIN=${CMAKE_DUMPBIN}"
                    -P "${_helper}"
                COMMENT "Verifying networking runtime imports for ${_app}"
                VERBATIM)
        endforeach()
    elseif(LUMINUMBRA_ENABLE_STEAM AND UNIX AND NOT APPLE)
        add_custom_target(luminumbra_network_runtime
            COMMAND ${CMAKE_COMMAND} -E make_directory "${_runtime_dir}"
            COMMAND ${CMAKE_COMMAND} -E copy_if_different
                "${LUMINUMBRA_STEAM_SDK_DIR}/redistributable_bin/linux64/libsteam_api.so"
                "${_runtime_dir}/libsteam_api.so"
            COMMAND ${CMAKE_COMMAND} -E make_directory
                "${CMAKE_CURRENT_BINARY_DIR}/network-runtime/$<CONFIG>"
            COMMAND ${CMAKE_COMMAND} -E touch "${_stamp}"
            BYPRODUCTS "${_stamp}"
            DEPENDS "${LUMINUMBRA_STEAM_SDK_DIR}/redistributable_bin/linux64/libsteam_api.so"
            COMMENT "Staging shared Steam runtime library"
            VERBATIM)
        foreach(_app IN LISTS _apps)
            add_dependencies(${_app} luminumbra_network_runtime)
        endforeach()
    endif()
endfunction()

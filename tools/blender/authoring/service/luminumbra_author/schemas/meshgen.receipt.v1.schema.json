{
  "additionalProperties": false,
  "maxProperties": 256,
  "properties": {
    "backend": {
      "maxLength": 64,
      "pattern": "^(?:[A-Za-z][A-Za-z0-9_-]{0,63})$",
      "type": "string"
    },
    "candidate": {
      "additionalProperties": false,
      "maxProperties": 256,
      "properties": {
        "artifact_sha256": {
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{64})$",
          "type": "string"
        },
        "bodies": {
          "maximum": 16000000,
          "minimum": 0,
          "type": "integer"
        },
        "bounds_m": {
          "items": {
            "maximum": 1000,
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "budget_ok": {
          "type": "boolean"
        },
        "dir": {
          "maxLength": 4096,
          "type": "string"
        },
        "provenance_sha256": {
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{64})$",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{64})$",
          "type": "string"
        },
        "tris": {
          "maximum": 16000000,
          "minimum": 0,
          "type": "integer"
        },
        "vertices": {
          "maximum": 16000000,
          "minimum": 0,
          "type": "integer"
        },
        "watertight": {
          "type": "boolean"
        }
      },
      "required": [
        "dir",
        "sha256",
        "artifact_sha256",
        "provenance_sha256",
        "tris",
        "vertices",
        "bodies",
        "watertight",
        "bounds_m",
        "budget_ok"
      ],
      "type": "object"
    },
    "config_digest": {
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{64})$",
      "type": "string"
    },
    "errors": {
      "items": {
        "additionalProperties": false,
        "maxProperties": 256,
        "properties": {
          "component_id": {
            "oneOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "field": {
            "maxLength": 4096,
            "type": "string"
          },
          "message": {
            "maxLength": 4096,
            "type": "string"
          },
          "node_id": {
            "oneOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "object_id": {
            "oneOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "rule_id": {
            "maxLength": 1024,
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ],
            "type": "string"
          }
        },
        "required": [
          "rule_id",
          "severity",
          "message",
          "field",
          "object_id",
          "component_id",
          "node_id"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "minItems": 0,
      "type": "array"
    },
    "executed": {
      "type": "boolean"
    },
    "flags": {
      "additionalProperties": false,
      "maxProperties": 256,
      "properties": {
        "waived": {
          "items": {
            "enum": [
              "final_tris_within_budget",
              "bounds_within_budgets",
              "thin_shell_guard",
              "uv_present",
              "uv_overlap_zero"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "waived"
      ],
      "type": "object"
    },
    "gates": {
      "additionalProperties": {
        "enum": [
          "pass",
          "fail",
          "na"
        ],
        "type": "string"
      },
      "maxProperties": 32,
      "properties": {},
      "required": [],
      "type": "object"
    },
    "licence": {
      "additionalProperties": false,
      "maxProperties": 256,
      "properties": {
        "ack_ids": {
          "items": {
            "maxLength": 4096,
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 0,
          "type": "array"
        },
        "shippable": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "shippable",
            "internal_ok",
            "internal_only",
            "counsel",
            "blocked"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "shippable",
        "ack_ids"
      ],
      "type": "object"
    },
    "origin": {
      "maxLength": 80,
      "pattern": "^(?:backend:[A-Za-z][A-Za-z0-9_-]{0,63}|ops:typed|ops:raw_bpy)$",
      "type": "string"
    },
    "plan_digest": {
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{64})$",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "pattern": "^(?:(?:generate|import):[A-Za-z0-9_.:-]{1,119})$",
      "type": "string"
    },
    "schema": {
      "const": "luminumbra.authoring.meshgen.receipt.v1",
      "type": "string"
    },
    "spatially_valid": {
      "type": "boolean"
    },
    "tier": {
      "enum": [
        "backend"
      ],
      "type": "string"
    },
    "timings": {
      "additionalProperties": {
        "maximum": 86400,
        "minimum": 0,
        "type": "number"
      },
      "maxProperties": 32,
      "properties": {},
      "required": [],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "request_id",
    "plan_digest",
    "config_digest",
    "tier",
    "origin",
    "backend",
    "licence",
    "candidate",
    "flags",
    "gates",
    "executed",
    "spatially_valid",
    "timings",
    "errors"
  ],
  "type": "object"
}

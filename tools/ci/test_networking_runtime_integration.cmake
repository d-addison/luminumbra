cmake_minimum_required(VERSION 3.21)

foreach(_required IN ITEMS NETWORK_TEST_ROOT NETWORK_TEST_GENERATOR NETWORK_TEST_COMPILER)
    if(NOT ${_required})
        message(FATAL_ERROR "Pass ${_required} for the networking build fixture")
    endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _run)
set(_root "${NETWORK_TEST_ROOT}/run-${_run}")
set(_source "${CMAKE_CURRENT_LIST_DIR}/networking_runtime_fixture")

function(run_step DESCRIPTION)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE _result
        OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 25)
    if(NOT "${_result}" STREQUAL "0")
        message(FATAL_ERROR "${DESCRIPTION} failed (${_result}):\n${_stdout}\n${_stderr}")
    endif()
endfunction()

function(assert_staged SOURCE RUNTIME_DIR)
    get_filename_component(_name "${SOURCE}" NAME)
    set(_staged "${RUNTIME_DIR}/${_name}")
    if(NOT EXISTS "${_staged}")
        message(FATAL_ERROR "Missing staged DLL: ${_staged}")
    endif()
    file(SHA256 "${SOURCE}" _source_hash)
    file(SHA256 "${_staged}" _staged_hash)
    if(NOT _source_hash STREQUAL _staged_hash)
        message(FATAL_ERROR "Staged DLL differs from its configuration's source: ${_staged}")
    endif()
endfunction()

# CI uses single-config Ninja. Also generate a real multi-config build graph
# there so Debug/Release isolation is covered on every Windows test run.
set(_generators "${NETWORK_TEST_GENERATOR}" "Ninja Multi-Config")
list(REMOVE_DUPLICATES _generators)
foreach(_generator IN LISTS _generators)
    string(MAKE_C_IDENTIFIER "${_generator}" _generator_key)
    set(_build "${_root}/${_generator_key}")
    set(_configure_args -S "${_source}" -B "${_build}" -G "${_generator}"
        "-DCMAKE_CXX_COMPILER=${NETWORK_TEST_COMPILER}"
        -DCMAKE_BUILD_TYPE=Release)
    # Preserve the host generator's platform/toolset, but do not pass those
    # options to Ninja Multi-Config (which does not accept them).
    if(_generator STREQUAL NETWORK_TEST_GENERATOR)
        if(NETWORK_TEST_PLATFORM)
            list(APPEND _configure_args -A "${NETWORK_TEST_PLATFORM}")
        endif()
        if(NETWORK_TEST_TOOLSET)
            list(APPEND _configure_args -T "${NETWORK_TEST_TOOLSET}")
        endif()
        if(NETWORK_TEST_MAKE_PROGRAM)
            list(APPEND _configure_args "-DCMAKE_MAKE_PROGRAM=${NETWORK_TEST_MAKE_PROGRAM}")
        endif()
    endif()
    run_step("Configure ${_generator}" "${CMAKE_COMMAND}" ${_configure_args})
    file(STRINGS "${_build}/CMakeCache.txt" _config_types REGEX "^CMAKE_CONFIGURATION_TYPES:")
    if(_config_types)
        set(_configs Debug Release)
    else()
        set(_configs Release)
    endif()
    foreach(_config IN LISTS _configs)
        include("${_build}/manifest-${_config}.cmake")
        if(FIXTURE_LEAF IN_LIST FIXTURE_TARGET_DLLS)
            message(FATAL_ERROR "The transitive DLL must be discovered by PE scanning")
        endif()
        if(_config_types AND NOT FIXTURE_RUNTIME_DIR STREQUAL "${_build}/bin/${_config}")
            message(FATAL_ERROR "Executable output directory is not isolated for ${_config}")
        endif()
        # Build the real staging target before the executable: its DLL
        # prerequisites must be sufficient even in a freshly configured tree.
        run_step("Stage ${_generator} ${_config}" "${CMAKE_COMMAND}" --build "${_build}"
            --config "${_config}" --target luminumbra_network_runtime --parallel 1)
        assert_staged("${FIXTURE_BACKEND}" "${FIXTURE_RUNTIME_DIR}")
        assert_staged("${FIXTURE_LEAF}" "${FIXTURE_RUNTIME_DIR}")
        set(_state "${_build}/network-runtime/${_config}")
        if(NOT EXISTS "${_state}/staged.stamp")
            message(FATAL_ERROR "Missing configuration-specific staging stamp")
        endif()
        file(STRINGS "${_state}/inputs.txt" _inputs)
        if(NOT FIXTURE_BACKEND IN_LIST _inputs OR FIXTURE_LEAF IN_LIST _inputs)
            message(FATAL_ERROR "Generated inputs must select the backend, leaving its import to the scanner")
        endif()
        foreach(_input IN LISTS _inputs)
            if(_input MATCHES "package files/" AND NOT _input STREQUAL FIXTURE_BACKEND)
                message(FATAL_ERROR "Generated inputs contain another configuration's DLL: ${_input}")
            endif()
        endforeach()
        run_step("Build preview ${_generator} ${_config}" "${CMAKE_COMMAND}" --build "${_build}"
            --config "${_config}" --target network_preview --parallel 1)
        run_step("Run preview ${_generator} ${_config}" "${FIXTURE_EXECUTABLE}")

        file(SHA256 "${FIXTURE_EXECUTABLE}" _executable_hash)
        file(TIMESTAMP "${FIXTURE_EXECUTABLE}" _executable_time "%s")
        get_filename_component(_leaf_name "${FIXTURE_LEAF}" NAME)
        file(REMOVE "${FIXTURE_RUNTIME_DIR}/${_leaf_name}")
        # Nothing that participates in compilation or linking has changed.
        # Building only the application must still run its staging prerequisite.
        run_step("Repair deleted DLL ${_generator} ${_config}" "${CMAKE_COMMAND}" --build "${_build}"
            --config "${_config}" --target network_preview --parallel 1)
        assert_staged("${FIXTURE_LEAF}" "${FIXTURE_RUNTIME_DIR}")
        file(SHA256 "${FIXTURE_EXECUTABLE}" _rebuilt_hash)
        file(TIMESTAMP "${FIXTURE_EXECUTABLE}" _rebuilt_time "%s")
        if(NOT _executable_hash STREQUAL _rebuilt_hash OR NOT _executable_time STREQUAL _rebuilt_time)
            message(FATAL_ERROR "DLL repair must not require relinking the executable")
        endif()
        run_step("Run repaired preview ${_generator} ${_config}" "${FIXTURE_EXECUTABLE}")
        file(SHA256 "${FIXTURE_LEAF}" _leaf_hash_${_config})
        set(_runtime_${_config} "${FIXTURE_RUNTIME_DIR}")
        set(_backend_${_config} "${FIXTURE_BACKEND}")
        set(_leaf_${_config} "${FIXTURE_LEAF}")
    endforeach()
    if(_config_types)
        if(_leaf_hash_Debug STREQUAL _leaf_hash_Release)
            message(FATAL_ERROR "Debug and Release fixture DLLs must have distinct contents")
        endif()
        # Recheck Debug after Release and then rebuild Debug once more: neither
        # build may overwrite the other configuration's staged DLLs.
        assert_staged("${_backend_Debug}" "${_runtime_Debug}")
        assert_staged("${_leaf_Debug}" "${_runtime_Debug}")
        run_step("Restage Debug after Release" "${CMAKE_COMMAND}" --build "${_build}"
            --config Debug --target luminumbra_network_runtime --parallel 1)
        assert_staged("${_backend_Release}" "${_runtime_Release}")
        assert_staged("${_leaf_Release}" "${_runtime_Release}")
    endif()
endforeach()

file(REMOVE_RECURSE "${_root}")
message(STATUS "Networking runtime build integration passed")

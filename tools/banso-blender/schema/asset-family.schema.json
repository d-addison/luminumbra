{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminumbra.dev/schemas/asset-family/v1.json",
  "title": "Luminumbra Blender asset family",
  "description": "A deterministic family of GLBs baked from one adjacent Blender graph file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceBlend",
    "targetObject",
    "expectedBlenderVersion",
    "parameterMatrix",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "The sidecar contract version."
    },
    "sourceBlend": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.blend$",
      "description": "The .blend filename beside this sidecar."
    },
    "targetObject": {
      "type": "string",
      "minLength": 1,
      "description": "The explicitly named geometry-nodes object to bake."
    },
    "expectedBlenderVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$",
      "description": "Required Blender major/minor or exact patch version."
    },
    "parameterMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seeds", "parameters"],
      "properties": {
        "seeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/parameterValue"
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "glbNamingPattern", "manifest"],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "description": "A relative directory resolved from the sidecar."
        },
        "glbNamingPattern": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.glb$",
          "description": "A filename pattern using {index} and/or {seed}."
        },
        "manifest": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.json$",
          "description": "The family manifest filename written in the output directory."
        }
      }
    }
  },
  "$defs": {
    "scalarParameterValue": {
      "type": ["string", "number", "boolean"]
    },
    "parameterValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/scalarParameterValue"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scalarParameterValue"
          }
        }
      ]
    }
  }
}

.forge/hooks/
.forge/output.json
.forge/trace-log.jsonl
.forge/trace-log.jsonl.lock
.forge/tmp/
# Transient build/run capture logs dumped during dev iteration (not source of truth)
.forge/artifacts/

# Forge-generated Codex native-agent profiles (per-task, never source)
.codex/agents/

# Local-only project data
/worlds/saves/
/docs/internal/

# OS files
.DS_Store
Thumbs.db

# Steamworks SDK (NOT redistributable -- owner-provided, never commit)
vendor/steamworks/
tools/blender/fixtures/*.blend
tools/blender/fixtures/staging/

# --- Dev capture dumps ---------------------------------------------------
# Loose run/gate/diagnostic captures written to the repo root during dev
# iteration, relocated out of the root. Reproduced by re-running the gate.
/scratch/

# --- Python bytecode -----------------------------------------------------
__pycache__/
*.py[cod]

# --- Local agent/editor state -------------------------------------------
.claude/settings.local.json
**/.banso/evidence/

# --- Forge per-run state -------------------------------------------------
# Authored under .forge/: config.yaml, architecture.toml, workflows/, specs/,
# prompts/, scripts/, reports/ and the critique-*.md write-ups. Everything
# below is regenerated by a run and must not be committed. log-signing.key is
# HMAC key material.
.forge/log-signing.key
.forge/*.jsonl
.forge/*.jsonl.lock
.forge/*.jsonl.gz.*
.forge/integration.lock
.forge/budgets.json
.forge/structure.json
.forge/structure.md
.forge/traceability-session.json
.forge/.last-infra-critique-path.txt
.forge/_*.txt
.forge/critique-cache/
.forge/sessions/
.forge/context/
.forge/logs/
.forge/pipeline-outputs/
.forge/worktree-task-ids/
.forge/tasks/
.forge/_flip/
.forge/_trio/
.forge/preview-capture-final/

# --- Vendored trees restored at configure time ---------------------------
# vendor/CMakeLists.txt pins these upstream via FetchContent and file(COPY)s
# them back onto the on-disk paths the build hardcodes. Editing them is a
# no-op; the next configure overwrites. sol2 and spdlog no longer build from
# their on-disk remnants at all.
/vendor/imgui/backends/
/vendor/meshoptimizer/
/vendor/soil2/
/vendor/stb/
/vendor/sol2/
/vendor/spdlog/

# --- Raw DCC source material ---------------------------------------------
# Hundreds of MB of unbaked GLTF/JPG working files. The asset bake globs
# assets/**/*.glb only, so nothing here is a build input.
/assets/models/

# --- Capture output ------------------------------------------------------
/references/compare/
/data/ui/captures/
/data/textures/models/
/photos/
/scratch_six/

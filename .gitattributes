# Normalise text to LF in the object store. This working tree is reached from
# both the Windows git (core.autocrlf=true, which writes CRLF on checkout) and
# the WSL git (core.autocrlf=false, which expects LF), so without this every
# checked-out text file reads as wholly modified to whichever git did not write
# it -- 610 files at once, byte-identical once CR is stripped. text=auto makes
# the comparison and the commit happen on normalised bytes, so the churn can
# neither be seen nor be committed. Binary files are detected and left alone.
* text=auto
# Upstream schema pin and embedded traversal identity use exact file bytes.
tools/release/spdx/spdx-2.3.schema.json -text
tools/perf/fixtures/*.traversal -text
# Devel persistence oracle: preserve exact fixture bytes on every platform.
test/fixtures/active-regions/devel-off/* -text
test/fixtures/active-regions/devel-off-plant-edit/* -text

# Fixed serializer baseline bytes; the test handles native Windows stream newlines.
test/fixtures/smoke_artifact/devel-*.json -text

# Original acceptance receipts retain byte identity across platforms.
docs/evidence/blender-presentation-20260913/*.json -text

# Catalog and historical receipt identities must survive native Windows checkout.
docs/visual-catalog*.json text eol=lf
docs/assets/visual-baselines/20260908/*.json text eol=lf

# Reviewed dependency inputs and delivery code have byte-bound identities.
cmake/patches/rmlui-* text eol=lf
vendor/rmlui/rmlui-6.1-source.json text eol=lf
tools/ci/rmlui_source.py text eol=lf
# Jolt overlay identities hash materialized bytes on every checkout.
cmake/patches/jolt-startup.json text eol=lf
cmake/patches/jolt-startup.patch text eol=lf
tools/ci/jolt_startup.py text eol=lf
tools/ci/path_safety.py text eol=lf
cmake/jolt_startup.cmake text eol=lf
vendor/CMakeLists.txt text eol=lf

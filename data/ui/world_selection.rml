<rml>
    <head>
        <title>Load World - Luminumbra</title>
        <link type="text/css" href="base.rcss" />
        <link type="text/css" href="game_theme.rcss" />
    </head>
    <body id="world_selection" class="fade-in">
        <div class="container">
            <h1>select world</h1>
            <div class="title-ornament">&#9670;</div>
            <div id="world_list" class="list-container">
                <p id="world_list_status" class="text-secondary hidden"></p>
                <div id="no_worlds" class="text-center p-lg hidden">
                    <p class="text-lg mb-md">No saved worlds yet</p>
                    <p class="text-sm text-secondary">Create a world to get started.</p>
                </div>
                <div id="world_list_items" class="cards-row"></div>
            </div>
            <button id="load_selected_btn" class="btn" disabled>Load selected world</button>
            <button id="new_world_btn" class="btn btn-secondary">Create world</button>
            <span id="back_btn" class="back-link">&#8249; back</span>
        </div>
        <div id="notification" class="notification hidden">
            <span id="notification_text"></span>
        </div>
    </body>
</rml>

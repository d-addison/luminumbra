<rml>
    <head>
        <title>Load World - Luminumbra</title>
        <link type="text/css" href="base.rcss" />
        <link type="text/css" href="game_theme.rcss" />
    </head>
    <body id="world_selection" class="fade-in">
        <div class="container">
            <h1>Load World</h1>
            
            <!-- Search and filter bar -->
            <div class="search-container mb-lg">
                <div class="form-group">
                    <input type="text" 
                           id="world_search" 
                           placeholder="Search worlds..."
                           class="form-control" />
                </div>
                <div class="filter-buttons gap-sm">
                    <button id="filter_all" class="btn btn-sm btn-secondary">All</button>
                    <button id="filter_recent" class="btn btn-sm btn-secondary">Recent</button>
                    <button id="filter_favorites" class="btn btn-sm btn-secondary">Favorites</button>
                </div>
            </div>
            
            <!-- World list container -->
            <div id="world_list" class="list-container">
                <!-- Loading state -->
                <div id="loading_worlds" class="text-center p-lg">
                    <div class="loading-spinner"></div>
                    <p class="mt-md">Loading worlds...</p>
                </div>
                
                <!-- Empty state -->
                <div id="no_worlds" class="text-center p-lg hidden">
                    <p class="text-lg mb-md">No worlds found</p>
                    <p class="text-sm text-secondary">Create your first world to get started!</p>
                </div>
                
                <!-- World list items (dynamically populated) -->
                <div id="world_list_items">
                    <!-- Example world entries -->
                    <div class="list-item" data-world-id="world_1661381313_1234">
                        <div class="world-entry-header">
                            <h3 class="list-item-title">My First World</h3>
                            <div class="world-actions">
                                <button class="btn btn-sm btn-secondary world-favorite" data-favorite="false">☆</button>
                                <button class="btn btn-sm btn-danger world-delete">Delete</button>
                            </div>
                        </div>
                        <p class="list-item-description">
                            Type: Default | Seed: 1337 | Size: Medium<br/>
                            Last played: 2 hours ago | 15.2 MB
                        </p>
                        <div class="world-preview">
                            <!-- Optional: miniature world preview -->
                            <div class="world-thumbnail"></div>
                        </div>
                    </div>
                    
                    <div class="list-item" data-world-id="world_1661381599_5678">
                        <div class="world-entry-header">
                            <h3 class="list-item-title">Archipelago Adventure</h3>
                            <div class="world-actions">
                                <button class="btn btn-sm btn-secondary world-favorite" data-favorite="true">★</button>
                                <button class="btn btn-sm btn-danger world-delete">Delete</button>
                            </div>
                        </div>
                        <p class="list-item-description">
                            Type: Archipelago | Seed: 98765 | Size: Large<br/>
                            Last played: 1 week ago | 42.7 MB
                        </p>
                        <div class="world-preview">
                            <div class="world-thumbnail"></div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Action buttons -->
            <div class="button-container">
                <button id="back_btn" class="btn btn-secondary">
                    Back
                </button>
                <button id="load_selected_btn" class="btn btn-primary" disabled>
                    Load World
                </button>
                <button id="import_world_btn" class="btn btn-secondary">
                    Import
                </button>
            </div>
        </div>
        
        <!-- Confirmation modal for world deletion -->
        <div id="delete_confirmation_modal" class="modal-overlay hidden">
            <div class="modal">
                <div class="modal-header">
                    <h2 class="modal-title">Delete World</h2>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete "<span id="world_to_delete"></span>"?</p>
                    <p class="text-sm text-secondary">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button id="cancel_delete_btn" class="btn btn-secondary">Cancel</button>
                    <button id="confirm_delete_btn" class="btn btn-danger">Delete</button>
                </div>
            </div>
        </div>
        
        <!-- Notification area -->
        <div id="notification" class="notification hidden">
            <span id="notification_text"></span>
        </div>
    </body>
</rml>
/* ===== QUANTUM VISUAL EFFECTS ===== */
/* Advanced animations and visual effects for the Quantum theme */

/* ===== QUANTUM BACKGROUND EFFECTS ===== */

.quantum-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
}

.particle {
    position: absolute;
    width: 2px;
    height: 2px;
    background: var(--color-primary);
    border-radius: 50%;
    opacity: 0.3;
    animation: float 6s infinite ease-in-out;
}

.particle:nth-child(1) {
    left: 20%;
    animation-delay: 0s;
    animation-duration: 8s;
}

.particle:nth-child(2) {
    left: 60%;
    animation-delay: 2s;
    animation-duration: 6s;
}

.particle:nth-child(3) {
    left: 80%;
    animation-delay: 4s;
    animation-duration: 10s;
}

@keyframes float {
    0%, 100% {
        transform: translateY(100vh) scale(0);
        opacity: 0;
    }
    10% {
        opacity: 0.3;
        transform: scale(1);
    }
    90% {
        opacity: 0.3;
    }
    100% {
        transform: translateY(-100px) scale(0);
        opacity: 0;
    }
}

/* ===== BUTTON ANIMATIONS ===== */

.btn {
    position: relative;
    overflow: hidden;
    transform-style: preserve-3d;
}

.btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transition: left var(--duration-slow) var(--easing-ease-out);
}

.btn:hover::before {
    left: 100%;
}

.btn.animate-click {
    animation: clickPulse var(--duration-fast) var(--easing-ease-out);
}

@keyframes clickPulse {
    0% {
        transform: scale(1);
        box-shadow: var(--shadow-sm);
    }
    50% {
        transform: scale(0.98);
        box-shadow: var(--shadow-lg);
    }
    100% {
        transform: scale(1);
        box-shadow: var(--shadow-sm);
    }
}

/* ===== LOADING ANIMATIONS ===== */

.btn.loading::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 16px;
    height: 16px;
    margin: -8px 0 0 -8px;
    border: 2px solid transparent;
    border-top: 2px solid var(--color-text-primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

.btn.loading {
    color: transparent !important;
}

/* ===== FORM FOCUS EFFECTS ===== */

.form-control {
    position: relative;
    transition: all var(--duration-fast) var(--easing-ease-in-out);
}

.form-control:focus {
    box-shadow: 0 0 0 3px rgba(79, 91, 102, 0.1);
    transform: translateY(-1px);
}

.form-control.focused {
    transform: translateY(-1px);
}

/* ===== PANEL ANIMATIONS ===== */

.panel {
    transition: all var(--duration-normal) var(--easing-ease-in-out);
}

.panel.collapsed .panel-body {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    padding-top: 0;
    padding-bottom: 0;
    transition: all var(--duration-normal) var(--easing-ease-in-out);
}

.panel.expanded .panel-body {
    max-height: 1000px; /* Large enough to accommodate content */
    opacity: 1;
    transition: all var(--duration-normal) var(--easing-ease-out);
}

.panel-toggle {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    float: right;
    margin-top: -2px;
    transition: transform var(--duration-fast) var(--easing-ease-in-out);
}

.panel.collapsed .panel-toggle {
    transform: rotate(45deg);
}

/* ===== LIST ANIMATIONS ===== */

.list-item {
    transition: all var(--duration-fast) var(--easing-ease-in-out);
    transform: translateX(0);
}

.list-item:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-sm);
}

.list-item.selected {
    background-color: rgba(79, 91, 102, 0.1);
    border-left: 4px solid var(--color-primary);
    transform: translateX(4px);
}

/* ===== WORLD ENTRY SPECIFIC STYLES ===== */

.world-entry-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--spacing-sm);
}

.world-actions {
    display: flex;
    gap: var(--spacing-sm);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--easing-ease-in-out);
}

.list-item:hover .world-actions {
    opacity: 1;
}

.world-favorite {
    background: transparent !important;
    border: none !important;
    padding: var(--spacing-xs) !important;
    color: var(--color-warning);
    font-size: var(--font-size-lg);
}

.world-favorite[data-favorite="true"] {
    color: var(--color-warning);
}

.world-favorite[data-favorite="false"] {
    color: var(--color-text-tertiary);
}

.world-thumbnail {
    width: 60px;
    height: 40px;
    background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-surface-elevated) 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    margin-top: var(--spacing-sm);
    position: relative;
    overflow: hidden;
}

.world-thumbnail::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 30% 30%, rgba(79, 91, 102, 0.3) 0%, transparent 50%);
}

/* ===== SEARCH AND FILTER STYLES ===== */

.search-container {
    display: flex;
    gap: var(--spacing-md);
    align-items: flex-end;
}

.search-container .form-group {
    flex: 1;
    margin-bottom: 0;
}

.filter-buttons {
    display: flex;
}

.filter-buttons .btn.active {
    background-color: var(--color-primary);
    color: var(--color-text-primary);
}

/* ===== MODAL ANIMATIONS ===== */

.modal-overlay {
    backdrop-filter: blur(4px);
    animation: fadeIn var(--duration-normal) var(--easing-ease-out);
}

.modal {
    animation: modalSlideIn var(--duration-normal) var(--easing-ease-out);
    transform: translateY(0);
}

@keyframes fadeIn {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

@keyframes modalSlideIn {
    from {
        opacity: 0;
        transform: translateY(-50px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* ===== NOTIFICATION STYLES ===== */

.notification {
    animation: slideInRight var(--duration-normal) var(--easing-ease-out);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
}

.notification.fade-out {
    animation: slideOutRight var(--duration-normal) var(--easing-ease-in);
}

@keyframes slideInRight {
    from {
        transform: translateX(100%);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

@keyframes slideOutRight {
    from {
        transform: translateX(0);
        opacity: 1;
    }
    to {
        transform: translateX(100%);
        opacity: 0;
    }
}

/* ===== VERSION INFO ===== */

.version-info {
    position: fixed;
    bottom: var(--spacing-md);
    right: var(--spacing-md);
    opacity: 0.6;
    transition: opacity var(--duration-fast) var(--easing-ease-in-out);
}

.version-info:hover {
    opacity: 1;
}

/* ===== PROGRESS INDICATORS ===== */

.progress-bar {
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    box-shadow: 0 0 10px rgba(79, 91, 102, 0.3);
    position: relative;
}

.progress-bar::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.2) 50%, transparent 100%);
    animation: progressShimmer 2s infinite ease-in-out;
}

@keyframes progressShimmer {
    0% {
        transform: translateX(-100%);
    }
    100% {
        transform: translateX(100%);
    }
}

/* ===== RESPONSIVE DESIGN ===== */

@media (max-width: 768px) {
    .container {
        padding: 0 var(--spacing-md);
    }
    
    #nav {
        width: 100%;
    }
    
    .form-container {
        max-width: 100%;
    }
    
    .search-container {
        flex-direction: column;
        gap: var(--spacing-sm);
    }
    
    .world-entry-header {
        flex-direction: column;
        gap: var(--spacing-sm);
    }
    
    .world-actions {
        opacity: 1;
    }
}

/* ===== ACCESSIBILITY ENHANCEMENTS ===== */

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
    
    .particle {
        display: none;
    }
}

/* Focus indicators for keyboard navigation */
.btn:focus,
.form-control:focus,
.list-item:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
}

/* High contrast mode support */
@media (prefers-contrast: high) {
    :root {
        --color-background: #000000;
        --color-surface: #1a1a1a;
        --color-text-primary: #ffffff;
        --color-border: #ffffff;
        --shadow-sm: 0px 2px 8px rgba(255, 255, 255, 0.15);
        --shadow-md: 0px 4px 15px rgba(255, 255, 255, 0.25);
        --shadow-lg: 0px 6px 20px rgba(255, 255, 255, 0.35);
    }
}
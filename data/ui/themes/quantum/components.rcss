/* ===== COMPONENT STYLES ===== */
/* Reusable UI component styles for the Quantum theme */

/* ===== BUTTONS ===== */

.btn {
    display: inline-block;
    padding: var(--spacing-md) var(--spacing-lg);
    font-family: var(--font-family-primary);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    text-align: center;
    text-decoration: none;
    border-radius: var(--border-radius-md);
    border-width: 2px;
    border-style: solid;
    cursor: pointer;
    transition: all var(--duration-fast) var(--easing-ease-in-out);
    user-select: none;
    outline: none;
}

/* Primary Button */
.btn-primary {
    background-color: var(--color-primary);
    border-color: var(--color-secondary);
    color: var(--color-text-primary);
    box-shadow: var(--shadow-sm);
}

.btn-primary:hover {
    background-color: var(--color-primary-hover);
    border-color: var(--color-secondary-hover);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
}

.btn-primary:active {
    background-color: var(--color-primary-active);
    border-color: var(--color-secondary-active);
    box-shadow: var(--shadow-sm);
    transform: translateY(0);
}

/* Accent Button */
.btn-accent {
    background-color: var(--color-accent);
    border-color: var(--color-accent-hover);
    color: var(--color-text-primary);
    box-shadow: var(--shadow-sm);
}

.btn-accent:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
}

.btn-accent:active {
    background-color: var(--color-accent-active);
    border-color: var(--color-accent-active);
    transform: translateY(0);
}

/* Success Button */
.btn-success {
    background-color: var(--color-success);
    border-color: var(--color-success-hover);
    color: var(--color-text-primary);
}

.btn-success:hover {
    background-color: var(--color-success-hover);
    border-color: var(--color-success-hover);
}

.btn-success:active {
    background-color: var(--color-success-active);
    border-color: var(--color-success-active);
}

/* Danger Button */
.btn-danger {
    background-color: var(--color-danger);
    border-color: var(--color-danger-hover);
    color: var(--color-text-primary);
}

.btn-danger:hover {
    background-color: var(--color-danger-hover);
    border-color: var(--color-danger-hover);
}

.btn-danger:active {
    background-color: var(--color-danger-active);
    border-color: var(--color-danger-active);
}

/* Secondary Button */
.btn-secondary {
    background-color: transparent;
    border-color: var(--color-secondary);
    color: var(--color-secondary);
}

.btn-secondary:hover {
    background-color: var(--color-secondary);
    border-color: var(--color-secondary);
    color: var(--color-text-inverse);
}

/* Button Sizes */
.btn-sm {
    padding: var(--spacing-sm) var(--spacing-md);
    font-size: var(--font-size-sm);
    height: var(--button-height-sm);
}

.btn-lg {
    padding: var(--spacing-lg) var(--spacing-xl);
    font-size: var(--font-size-xl);
    height: var(--button-height-lg);
}

/* Default button styles (for backward compatibility) */
button {
    display: block;
    width: 100%;
    height: var(--button-height);
    margin-bottom: var(--spacing-lg);
    background-color: var(--color-primary);
    border-width: 2px;
    border-style: solid;
    border-color: var(--color-secondary);
    border-radius: var(--border-radius-md);
    color: var(--color-text-primary);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    font-family: var(--font-family-primary);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: all var(--duration-fast) var(--easing-ease-in-out);
}

button:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent-hover);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
}

button:active {
    background-color: var(--color-accent-active);
    border-color: var(--color-accent-active);
    box-shadow: var(--shadow-sm);
    transform: translateY(0);
}

/* ===== FORM ELEMENTS ===== */

label {
    display: block;
    margin-bottom: var(--spacing-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    font-size: var(--font-size-base);
}

input[type="text"],
input[type="number"],
input[type="email"],
input[type="password"],
textarea {
    width: 100%;
    padding: var(--input-padding);
    font-size: var(--font-size-base);
    font-family: var(--font-family-primary);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-primary);
    transition: all var(--duration-fast) var(--easing-ease-in-out);
    box-sizing: border-box;
}

input[type="text"]:focus,
input[type="number"]:focus,
input[type="email"]:focus,
input[type="password"]:focus,
textarea:focus {
    outline: none;
    border-color: var(--color-border-focus);
    background-color: var(--color-surface-elevated);
    box-shadow: 0 0 0 3px rgba(102, 119, 136, 0.1);
}

input[type="text"]:hover,
input[type="number"]:hover,
input[type="email"]:hover,
input[type="password"]:hover,
textarea:hover {
    border-color: var(--color-border-light);
    background-color: var(--color-surface-hover);
}

/* Select Elements */
select {
    width: 100%;
    padding: var(--input-padding);
    font-size: var(--font-size-base);
    font-family: var(--font-family-primary);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: all var(--duration-fast) var(--easing-ease-in-out);
}

select:focus {
    outline: none;
    border-color: var(--color-border-focus);
    background-color: var(--color-surface-elevated);
    box-shadow: 0 0 0 3px rgba(102, 119, 136, 0.1);
}

select:hover {
    border-color: var(--color-border-light);
    background-color: var(--color-surface-hover);
}

/* Form Validation States */
.input-error {
    border-color: var(--color-danger) !important;
    background-color: rgba(220, 38, 38, 0.05) !important;
}

.input-success {
    border-color: var(--color-success) !important;
    background-color: rgba(74, 124, 89, 0.05) !important;
}

.field-error {
    font-size: var(--font-size-sm);
    color: var(--color-danger);
    margin-top: var(--spacing-xs);
}

.field-help {
    font-size: var(--font-size-sm);
    color: var(--color-text-tertiary);
    margin-top: var(--spacing-xs);
}

/* ===== PANELS ===== */

.panel {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: var(--panel-padding);
    box-shadow: var(--shadow-sm);
}

.panel-elevated {
    background-color: var(--color-surface-elevated);
    box-shadow: var(--shadow-md);
}

.panel-header {
    padding-bottom: var(--spacing-md);
    margin-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
}

.panel-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
}

/* ===== MODAL ===== */

.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
}

.modal {
    background-color: var(--color-surface-elevated);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-xl);
    max-width: var(--modal-max-width);
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
}

.modal-header {
    padding: var(--spacing-lg);
    border-bottom: 1px solid var(--color-border);
}

.modal-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
}

.modal-body {
    padding: var(--spacing-lg);
}

.modal-footer {
    padding: var(--spacing-lg);
    border-top: 1px solid var(--color-border);
    text-align: right;
}

/* ===== LIST ITEMS ===== */

.list-item {
    padding: var(--spacing-md) var(--spacing-lg);
    border-bottom: 1px solid var(--color-border);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--easing-ease-in-out);
}

.list-item:last-child {
    border-bottom: none;
}

.list-item:hover {
    background-color: var(--color-surface-hover);
}

.list-item-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-xs) 0;
}

.list-item-description {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin: 0;
}

/* ===== PROGRESS BARS ===== */

.progress-container {
    width: 100%;
    height: 8px;
    background-color: var(--color-surface);
    border-radius: var(--border-radius-full);
    overflow: hidden;
}

.progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    transition: width var(--duration-normal) var(--easing-ease-out);
}

/* ===== NOTIFICATIONS ===== */

.notification {
    position: fixed;
    top: var(--spacing-lg);
    right: var(--spacing-lg);
    background-color: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: var(--spacing-md) var(--spacing-lg);
    box-shadow: var(--shadow-lg);
    z-index: 1001;
    max-width: 400px;
}

.notification-success {
    border-color: var(--color-success);
    background-color: rgba(74, 124, 89, 0.1);
}

.notification-warning {
    border-color: var(--color-warning);
    background-color: rgba(255, 133, 0, 0.1);
}

.notification-error {
    border-color: var(--color-danger);
    background-color: rgba(220, 38, 38, 0.1);
}

/* ===== LOADING SPINNER ===== */

.loading-spinner {
    width: 32px;
    height: 32px;
    border: 3px solid var(--color-border);
    border-top: 3px solid var(--color-primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: var(--spacing-md) auto;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}
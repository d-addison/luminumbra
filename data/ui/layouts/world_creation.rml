<rml>
    <head>
        <title>Create New World - Luminumbra</title>
        <link type="text/css" href="../themes/quantum/quantum-theme.rcss" />
        <link type="text/css" href="../themes/quantum/components.rcss" />
    </head>
    <body id="world_creation" class="fade-in">
        <div class="container">
            <h1>Create New World</h1>
            
            <!-- World creation form -->
            <div class="form-container">
                <form id="world_creation_form">
                    <!-- World name input -->
                    <div class="form-group">
                        <label for="world_name">World Name</label>
                        <input type="text" 
                               id="world_name" 
                               name="world_name" 
                               placeholder="Enter world name..." 
                               value="New World"
                               class="form-control" 
                               required />
                        <div class="field-help">
                            Choose a unique name for your world
                        </div>
                    </div>
                    
                    <!-- World seed input -->
                    <div class="form-group">
                        <label for="world_seed">Seed (Optional)</label>
                        <input type="text" 
                               id="world_seed" 
                               name="world_seed" 
                               placeholder="Leave empty for random generation..."
                               class="form-control" />
                        <div class="field-help">
                            Enter a seed for repeatable world generation
                        </div>
                    </div>
                    
                    <!-- World type selection -->
                    <div class="form-group">
                        <label for="world_type">World Type</label>
                        <select id="world_type" name="world_type" class="form-control">
                            <option value="default">Default Terrain</option>
                            <option value="archipelago">Archipelago</option>
                            <option value="mountains">Mountainous</option>
                            <option value="flat_lands">Flat Plains</option>
                            <option value="temperate_forest">Temperate Forest</option>
                            <option value="desert">Desert Wasteland</option>
                            <option value="frozen">Frozen Tundra</option>
                        </select>
                        <div class="field-help">
                            Choose the primary terrain type for your world
                        </div>
                    </div>
                    
                    <!-- Advanced options panel -->
                    <div id="advanced_options" class="panel panel-transparent">
                        <div class="panel-header">
                            <h3 class="panel-title">Advanced Options</h3>
                        </div>
                        <div class="panel-body">
                            <div class="form-group">
                                <label for="world_size">World Size</label>
                                <select id="world_size" name="world_size" class="form-control">
                                    <option value="small">Small (2km x 2km)</option>
                                    <option value="medium" selected>Medium (4km x 4km)</option>
                                    <option value="large">Large (8km x 8km)</option>
                                    <option value="huge">Huge (16km x 16km)</option>
                                </select>
                            </div>
                            
                            <div class="form-group">
                                <label for="difficulty">Difficulty</label>
                                <select id="difficulty" name="difficulty" class="form-control">
                                    <option value="peaceful">Peaceful</option>
                                    <option value="easy">Easy</option>
                                    <option value="normal" selected>Normal</option>
                                    <option value="hard">Hard</option>
                                    <option value="hardcore">Hardcore</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            
            <!-- Action buttons -->
            <div class="button-container">
                <button id="back_btn" class="btn btn-secondary">
                    Back
                </button>
                <button id="create_btn" class="btn btn-success">
                    Create World
                </button>
            </div>
            
            <!-- Progress indicator (hidden by default) -->
            <div id="creation_progress" class="hidden mt-lg">
                <div class="progress-container">
                    <div id="progress_bar" class="progress-bar" style="width: 0%;"></div>
                </div>
                <p class="text-center text-sm mt-sm">
                    <span id="progress_text">Generating world...</span>
                </p>
            </div>
        </div>
        
        <!-- Notification area -->
        <div id="notification" class="notification hidden">
            <span id="notification_text"></span>
        </div>
    </body>
</rml>
<rml>
    <head>
        <title>Create New World</title>
        <link type="text/css" href="game_theme.rcss" />
        <style>
            body {
                text-align: center;
            }

            h1 {
                margin-top: 50px;
                margin-bottom: 30px;
            }

            .form-container {
                width: 400px;
                margin: 0 auto;
                text-align: left;
            }

            .form-group {
                margin-bottom: 20px;
            }

            label {
                display: block;
                margin-bottom: 5px;
                font-weight: bold;
                color: #e0e0e0;
            }

            input[type="text"] {
                width: 100%;
                padding: 10px;
                font-size: 16px;
                background-color: #2a2a2a;
                border: 1px #444;
                color: #fff;
            }

            input[type="text"]:focus {
                border-color: #667788;
                background-color: #333;
            }

            select {
                width: 100%;
                padding: 10px;
                font-size: 16px;
                background-color: #2a2a2a;
                border: 1px #444;
                color: #fff;
            }

            .button-container {
                margin-top: 40px;
                text-align: center;
            }

            button {
                margin: 0 10px;
                min-width: 120px;
            }

            #create_btn {
                background-color: #4a7c59;
            }

            #create_btn:hover {
                background-color: #5a8d69;
            }

            .seed-info {
                font-size: 12px;
                color: #999;
                margin-top: 5px;
            }
        </style>
    </head>
    <body id="world_creation">
        <h1>Create New World</h1>

        <div class="form-container">
            <div class="form-group">
                <label for="world_name">World Name</label>
                <input type="text" id="world_name" name="world_name" value="New World" />
            </div>

            <div class="form-group">
                <label for="world_seed">Seed (Optional)</label>
                <input type="text" id="world_seed" name="world_seed" placeholder="Leave empty for random seed" />
                <p class="seed-info">Enter a seed for repeatable world generation</p>
            </div>

            <div class="form-group">
                <label for="world_type">World Type</label>
                <select id="world_type" name="world_type">
                    <option value="default">Default</option>
                    <option value="archipelago">Archipelago</option>
                    <option value="mountains">Mountainous</option>
                    <option value="flat">Flat Lands</option>
                </select>
            </div>
        </div>

        <div class="button-container">
            <button id="back_btn">Back</button>
            <button id="create_btn">Create World</button>
        </div>
    </body>
</rml>
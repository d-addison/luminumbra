/* ============================================================================
   game_theme.rcss — "Zen / Photographic Calm" visual language.
   Palette: warm-dusk near-black #16130E · ivory ink #F2EDE4 · sage #8FA68E ·
   dusk-gold focus #C9A86A · warm surfaces #1F1B14 · hairlines #3A3326.
   Type: Lora serif, light weight, generous letter-spacing, lots of space.
   Linked AFTER base.rcss (which supplies block/inline structural defaults).
   ============================================================================ */

body {
    width: 100%;
    height: 100%;
    color: #F2EDE4;
    font-family: Lora;
    /* F4: the menus render over the LIVE golden-hour world (main_client renders a scenic world
       behind the menu branch). Keep the field transparent so the world shows through; a gentle
       top-to-bottom darkening veil lifts text legibility without hiding the vista. When the
       backdrop is disabled the cleared back buffer shows through as near-black. */
    background-color: transparent;
    decorator: linear-gradient(180deg, rgba(11,9,6,90) 0%, rgba(11,9,6,40) 35%, rgba(11,9,6,120) 100%);
}

/* Main menu: centre the hero + nav vertically and horizontally. */
body#main_menu {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

/* ---- Title / hero ---- */
h1 {
    font-size: 74px;
    text-align: center;
    color: #F2EDE4;
    font-weight: normal;
    letter-spacing: 5px;
    margin-top: 8px;
    margin-bottom: 2px;
}

p.subtitle {
    text-align: center;
    font-style: italic;
    color: #8FA68E;
    font-size: 21px;
    letter-spacing: 1px;
    margin-bottom: 40px;
}

/* ---- Main-menu navigation ---- */
div#nav {
    text-align: center;
    width: 300px;
    margin-left: auto;
    margin-right: auto;
}

/* Base button: a calm "ghost" — hairline border, transparent fill, sage on hover. */
button {
    height: 48px;
    line-height: 46px;          /* vertically centre the single-line label */
    padding-left: 22px;
    padding-right: 22px;
    /* faint translucent fill so labels stay readable over the busy world backdrop */
    background-color: rgba(20, 17, 11, 130);
    border-width: 1px;
    border-color: #6B6450;
    color: #F2EDE4;
    font-size: 19px;
    font-weight: normal;
    font-family: Lora;
    text-align: center;
}

button:hover {
    background-color: #8FA68E;
    border-color: #A9C0A0;
    color: #16130E;
}

button:active {
    background-color: #7A9079;
    border-color: #8FA68E;
    color: #16130E;
}

/* Main-menu navigation: the big stacked, centered buttons. */
#nav button {
    display: block;
    width: 280px;
    margin-bottom: 16px;
    margin-left: auto;
    margin-right: auto;
    letter-spacing: 1px;
}

/* Small inline buttons — the filter row in Load World. */
.btn-sm {
    height: auto;
    width: auto;
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 15px;
    margin-right: 8px;
}

.container {
    text-align: center;
    width: 100%;
}

.version-info {
    position: absolute;
    bottom: 18px;
    right: 20px;
    color: #6E6656;
    font-size: 12px;
    letter-spacing: 1px;
}

/* ============================================================================
   Forms / settings — same Zen palette, left-aligned, spacious.
   ============================================================================ */

.form-container {
    width: 660px;
    margin-left: auto;
    margin-right: auto;
    text-align: left;
}

.settings-container {
    max-height: 70%;
    overflow-y: auto;
}

.settings-section {
    margin-bottom: 30px;
    padding: 22px;
    background-color: #1F1B14;
    border-width: 1px;
    border-color: #3A3326;
}

h2 {
    font-weight: normal;
    letter-spacing: 2px;
}

h2.settings-heading {
    font-size: 24px;
    color: #8FA68E;
    font-weight: normal;
    letter-spacing: 3px;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: #3A3326;
    padding-bottom: 8px;
}

.settings-row {
    display: block;
    margin-bottom: 18px;
}

.settings-row label {
    display: block;
    color: #D8CFBC;
    font-size: 17px;
    margin-bottom: 7px;
    letter-spacing: 0.5px;
}

.settings-value {
    color: #C9A86A;
    font-size: 15px;
}

.form-control {
    display: block;
    width: 100%;
    height: 38px;
    background-color: #14110C;
    border-width: 1px;
    border-color: #3A3326;
    color: #F2EDE4;
    font-size: 16px;
    font-family: Lora;
    padding-left: 10px;
    padding-right: 10px;
}

.form-control:focus {
    border-color: #C9A86A;
}

select.form-control { height: 38px; }
select.form-control option {
    background-color: #14110C;
    color: #F2EDE4;
}

.settings-slider {
    height: 24px;
    padding-left: 0px;
    padding-right: 0px;
}

input.settings-slider slidertrack {
    background-color: #14110C;
    border-width: 1px;
    border-color: #3A3326;
    height: 6px;
    margin-top: 9px;
}

input.settings-slider sliderbar {
    width: 16px;
    height: 22px;
    background-color: #8FA68E;
    border-width: 0px;
}

input.settings-slider sliderbar:hover { background-color: #A9C0A0; }

.field-help {
    color: #8A8270;
    font-size: 13px;
    font-style: italic;
    margin-top: 5px;
}

.settings-keybinds { color: #B3A892; font-size: 14px; }

.button-container {
    text-align: center;
    margin-top: 16px;
}

.button-container button {
    display: inline-block;
    width: 200px;
    margin-left: 10px;
    margin-right: 10px;
}

/* Primary action (Create World) — a soft sage-green affirmative. */
.btn-success {
    border-color: #6E8A6A;
    color: #BFD6B6;
}
.btn-success:hover {
    background-color: #6E8A6A;
    border-color: #8FA68E;
    color: #16130E;
}

.notification {
    position: absolute;
    top: 24px;
    left: 50%;
    margin-left: -170px;
    width: 340px;
    padding: 14px;
    background-color: #1F1B14;
    border-width: 1px;
    border-color: #8FA68E;
    color: #F2EDE4;
    text-align: center;
    font-size: 15px;
}

.notification.hidden { display: none; }
.hidden { display: none; }

/* ============================================================================
   World selection (world_selection.rml) — cards, utilities, delete modal.
   ============================================================================ */
.search-container { margin-bottom: 22px; }
.filter-buttons { text-align: center; margin-top: 10px; }

.list-container {
    text-align: left;
    max-height: 52%;
    overflow-y: auto;
    margin-bottom: 18px;
}

.list-item {
    display: block;
    padding: 16px 20px;
    margin-bottom: 12px;
    background-color: #1F1B14;
    border-width: 1px;
    border-color: #3A3326;
}
.list-item:hover { border-color: #6E8A6A; }

.world-entry-header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.list-item-title {
    color: #F2EDE4;
    font-size: 21px;
    font-weight: normal;
    letter-spacing: 1px;
}

.world-actions { display: flex; flex-direction: row; }

.list-item-description {
    color: #8A8270;
    font-size: 14px;
    margin-top: 6px;
}

/* World preview thumbnails aren't generated yet — hide the empty boxes. */
.world-thumbnail, .world-preview { display: none; }

.btn-danger { border-color: #7A4A42; color: #D8A39A; }
.btn-danger:hover { background-color: #7A4A42; border-color: #9A6A60; color: #16130E; }

button:disabled { color: #6E6656; border-color: #2A2620; }

/* Utility classes used across the form / list pages. */
.text-center { text-align: center; }
.text-sm { font-size: 14px; }
.text-lg { font-size: 22px; }
.text-secondary { color: #8A8270; }
.mb-md { margin-bottom: 12px; }
.mb-lg { margin-bottom: 24px; }
.mt-md { margin-top: 12px; }
.p-lg { padding: 24px; }

/* Delete-confirmation modal. */
.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(8, 6, 4, 205);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}
.modal {
    width: 440px;
    padding: 26px;
    background-color: #1F1B14;
    border-width: 1px;
    border-color: #3A3326;
    text-align: center;
}
.modal-title { color: #C9A86A; font-size: 24px; font-weight: normal; letter-spacing: 2px; }
.modal-body { margin-top: 12px; margin-bottom: 20px; color: #D8CFBC; }
.modal-footer { display: flex; flex-direction: row; justify-content: center; margin-top: 8px; }
.modal-footer button { margin-left: 8px; margin-right: 8px; }


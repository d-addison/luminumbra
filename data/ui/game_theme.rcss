/* ============================================================================
   game_theme.rcss — "Zen / Photographic Calm" visual language.
   Palette: warm-dusk near-black #16130E · ivory ink #F2EDE4 · sage #8FA68E ·
   dusk-gold focus #C9A86A · warm surfaces #1F1B14 · hairlines #3A3326.
   Type: Lora serif, light weight, generous letter-spacing, lots of space.
   Linked AFTER base.rcss (which supplies block/inline structural defaults).
   ============================================================================ */

body {
    width: 100%;
    height: 100%;
    color: #F2EDE4;
    font-family: Lora;
    /* F4: the menus render over the LIVE golden-hour world (main_client renders a scenic world
       behind the menu branch). Keep the field transparent so the world shows through; a gentle
       top-to-bottom darkening veil lifts text legibility without hiding the vista. When the
       backdrop is disabled the cleared back buffer shows through as near-black. */
    background-color: transparent;
    decorator: linear-gradient(180deg, rgba(11,9,6,90) 0%, rgba(11,9,6,40) 35%, rgba(11,9,6,120) 100%);
}

/* Main menu: centre the hero + nav, raised toward the upper third. */
body#main_menu {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
}

body#main_menu .container {
    padding-top: 18%;
}

/* ---- Title / hero ---- */
h1 {
    font-size: 96px;
    text-align: center;
    color: #F6F1E8;
    font-weight: normal;
    letter-spacing: 22px;
    margin-top: 8px;
    margin-bottom: 10px;
}

p.subtitle {
    text-align: center;
    font-style: italic;
    color: #C9B89A;
    font-size: 17px;
    letter-spacing: 5px;
    margin-bottom: 32px;
}

/* Shared title ornaments (used across settings / world pages). */
.title-divider {
    display: block;
    width: 64px;
    height: 1px;
    margin: 0 auto 40px auto;
    background-color: rgba(201, 168, 106, 110);
}

.title-ornament {
    text-align: center;
    color: rgba(201, 168, 106, 150);
    font-size: 11px;
    letter-spacing: 2px;
    margin-bottom: 26px;
}

/* ---- Main-menu navigation ---- */
div#nav {
    text-align: center;
    width: 360px;
    margin-left: auto;
    margin-right: auto;
}

/* Base button: a frosted pill — translucent warm fill, dusk-gold hairline, blur. */
button {
    height: 58px;
    line-height: 56px;          /* vertically centre the single-line label */
    padding-left: 28px;
    padding-right: 28px;
    background-color: rgba(34, 28, 20, 140);
    border-width: 1px;
    border-color: rgba(201, 168, 106, 110);
    border-radius: 26px;
    color: #EDE5D6;
    font-size: 20px;
    font-weight: normal;
    font-family: Lora;
    text-align: center;
    backdrop-filter: blur(12px);
    box-shadow: 0px 2px 18px rgba(8, 6, 4, 120);
}

button:hover {
    background-color: rgba(201, 168, 106, 60);
    border-color: rgba(201, 168, 106, 200);
    color: #FFF9EE;
    box-shadow: 0px 0px 22px rgba(201, 168, 106, 90);
}

button:active {
    background-color: rgba(201, 168, 106, 110);
    border-color: #C9A86A;
    color: #16130E;
}

/* Main-menu navigation: the big stacked, centered frosted pills. */
#nav button {
    display: block;
    width: 360px;
    margin-bottom: 16px;
    margin-left: auto;
    margin-right: auto;
    letter-spacing: 4px;
}

/* Small inline buttons — the filter row in Load World. */
.btn-sm {
    height: auto;
    width: auto;
    padding-top: 6px;
    padding-bottom: 6px;
    font-size: 15px;
    margin-right: 8px;
}

.container {
    text-align: center;
    width: 100%;
}

.version-info {
    position: absolute;
    bottom: 18px;
    right: 20px;
    color: rgba(180, 168, 140, 90);
    font-size: 11px;
    letter-spacing: 1px;
}

/* ============================================================================
   Forms / settings — same Zen palette, left-aligned, spacious.
   ============================================================================ */

.form-container {
    width: 660px;
    margin-left: auto;
    margin-right: auto;
    text-align: left;
}

.settings-container {
    max-height: none;
    overflow: visible;
}

/* body#settings layout — flex-centre the panel. */
body#settings {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

/* body#settings header */
body#settings h1 {
    font-size: 42px;
    letter-spacing: 16px;
    color: #F2EDE4;
    font-weight: normal;
    margin: 0 0 6px 0;
    text-align: center;
}

/* One frosted panel containing both columns. */
.settings-panel {
    width: 1080px;
    max-width: 76%;
    margin: 0 auto;
    padding: 48px 64px 40px;
    text-align: left;
    background-color: rgba(24, 20, 15, 150);
    backdrop-filter: blur(22px);
    border-width: 1px;
    border-color: rgba(242, 237, 228, 28);
    box-shadow: 0px 18px 60px rgba(0, 0, 0, 120);
}

.settings-columns {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

.settings-column {
    width: 47%;
}

/* The old cards are neutralized into plain blocks inside the panel. */
.settings-section {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin-bottom: 0;
}

h2 {
    font-weight: normal;
    letter-spacing: 2px;
}

h2.settings-heading {
    font-size: 15px;
    color: rgba(206, 189, 158, 210);
    font-weight: normal;
    letter-spacing: 4px;
    margin-bottom: 22px;
    border-bottom-width: 0;
    padding-bottom: 0;
}

.settings-row {
    display: block;
    margin-bottom: 22px;
}

.settings-row label {
    display: block;
    color: rgba(224, 215, 198, 200);
    font-size: 16px;
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.settings-value {
    color: #C9A86A;
    font-size: 15px;
    float: right;
}

/* Inline rows (vsync toggle / window-mode stepper). */
.settings-row-inline {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}
.settings-row-inline label {
    display: block;
    color: rgba(224, 215, 198, 200);
    font-size: 16px;
    letter-spacing: 1px;
    margin-bottom: 0;
}

/* VSync toggle pill. */
.toggle {
    display: inline-block;
    width: 46px;
    height: 22px;
    border-radius: 11px;
    background-color: rgba(60, 54, 40, 160);
    border-width: 1px;
    border-color: rgba(242, 237, 228, 30);
}
.toggle.on { background-color: rgba(143, 166, 142, 220); }
.toggle-knob {
    display: inline-block;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin-top: 2px;
    margin-left: 3px;
    background-color: #F2EDE4;
}
.toggle.on .toggle-knob { margin-left: 27px; }

/* Window-mode stepper. */
.stepper {
    display: flex;
    flex-direction: row;
    align-items: center;
}
.stepper-arrow {
    color: rgba(216, 207, 188, 130);
    font-size: 15px;
    padding: 0 10px;
}
.stepper-arrow:hover { color: #F2EDE4; }
.stepper-value {
    color: #D8CFBC;
    font-size: 15px;
    letter-spacing: 1px;
}

/* Keybind rows (right column). */
.keybind-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 9px 12px;
    margin-bottom: 4px;
}
.keybind-row.selected {
    background-color: rgba(143, 166, 142, 90);
    border-width: 1px;
    border-color: rgba(143, 166, 142, 130);
}
.keybind-row:hover { background-color: rgba(242, 237, 228, 18); }
.keybind-label {
    color: rgba(224, 215, 198, 200);
    font-size: 15px;
    letter-spacing: 1px;
}
.keybind-row.selected .keybind-label { color: #F2EDE4; }
.keybind-chip {
    color: #D8CFBC;
    font-size: 14px;
    letter-spacing: 1px;
}

/* Centered text-link back action. */
.back-link {
    display: block;
    text-align: center;
    margin-top: 30px;
    color: rgba(216, 207, 188, 130);
    font-size: 15px;
    letter-spacing: 3px;
    background-color: transparent;
    border-width: 0;
    box-shadow: none;
    backdrop-filter: none;
    border-radius: 0;
}
.back-link:hover {
    color: #F2EDE4;
    background-color: transparent;
    border-width: 0;
    box-shadow: none;
}

.form-control {
    display: block;
    width: 100%;
    height: 38px;
    background-color: #14110C;
    border-width: 1px;
    border-color: #3A3326;
    color: #F2EDE4;
    font-size: 16px;
    font-family: Lora;
    padding-left: 10px;
    padding-right: 10px;
}

.form-control:focus {
    border-color: #C9A86A;
}

select.form-control { height: 38px; }
select.form-control option {
    background-color: #14110C;
    color: #F2EDE4;
}

.settings-slider {
    height: 24px;
    padding-left: 0px;
    padding-right: 0px;
}

input.settings-slider slidertrack {
    background-color: rgba(242, 237, 228, 70);
    border-width: 0;
    height: 4px;
    margin-top: 10px;
}

input.settings-slider sliderbar {
    width: 14px;
    height: 14px;
    margin-top: -6px;
    border-radius: 7px;
    background-color: #D8CFBC;
    border-width: 0px;
}

input.settings-slider sliderbar:hover { background-color: #F2EDE4; }

.field-help {
    color: #8A8270;
    font-size: 13px;
    font-style: italic;
    margin-top: 5px;
}

.settings-keybinds { color: #B3A892; font-size: 14px; }

.button-container {
    text-align: center;
    margin-top: 16px;
}

.button-container button {
    display: inline-block;
    width: 200px;
    margin-left: 10px;
    margin-right: 10px;
}

/* Primary action (Create World) — a soft sage-green affirmative. */
.btn-success {
    border-color: #6E8A6A;
    color: #BFD6B6;
}
.btn-success:hover {
    background-color: #6E8A6A;
    border-color: #8FA68E;
    color: #16130E;
}

.notification {
    position: absolute;
    top: 24px;
    left: 50%;
    margin-left: -170px;
    width: 340px;
    padding: 14px;
    background-color: #1F1B14;
    border-width: 1px;
    border-color: #8FA68E;
    color: #F2EDE4;
    text-align: center;
    font-size: 15px;
}

.notification.hidden { display: none; }
.hidden { display: none; }

/* ============================================================================
   World selection (world_selection.rml) — cards, utilities, delete modal.
   ============================================================================ */
/* Search / filters hidden in the photo-card layout. */
.search-container { display: none; }
.filter-buttons { display: none; }

/* World selection header. */
body#world_selection h1 {
    font-size: 40px;
    letter-spacing: 8px;
    color: #E8E0D2;
    margin: 28px 0 8px;
}

.list-container {
    text-align: center;
    overflow: visible;
    max-height: none;
    margin-bottom: 28px;
}

/* Centered row of photo cards. */
.cards-row {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

.list-item {
    display: block;
    width: 300px;
    margin: 0 14px;
    padding: 14px 14px 18px;
    text-align: center;
    background-color: rgba(28, 24, 17, 110);
    backdrop-filter: blur(14px);
    border-width: 1px;
    border-color: rgba(242, 237, 228, 28);
    border-radius: 6px;
    box-shadow: 0px 18px 40px rgba(8, 6, 4, 150);
}
.list-item:hover {
    border-color: rgba(242, 237, 228, 60);
    background-color: rgba(34, 29, 20, 130);
}
.list-item.selected {
    border-color: #C9A86A;
    box-shadow: 0px 18px 40px rgba(8, 6, 4, 170);
}

.list-item-title {
    color: #E8E0D2;
    font-size: 22px;
    font-weight: normal;
    letter-spacing: 2px;
    text-align: center;
    margin-top: 14px;
    margin-bottom: 6px;
}

.list-item-description {
    color: #8A8270;
    font-size: 12px;
    letter-spacing: 1px;
    text-align: center;
}

/* Thumbnail placeholder (real captures come later). */
.world-thumbnail {
    display: block;
    width: 100%;
    height: 150px;
    background-color: #14110C;
    decorator: linear-gradient(135deg, #2A2114 0%, #17130C 60%, #0B0906 100%);
    border-width: 1px;
    border-color: rgba(242, 237, 228, 22);
    border-radius: 4px;
}

/* Selection dot under each card. */
.select-dot {
    display: block;
    width: 6px;
    height: 6px;
    margin: 12px auto 0;
    border-radius: 4px;
    background-color: #C9A86A;
    opacity: 0;
}
.list-item.selected .select-dot { opacity: 1; }

.btn-danger { border-color: #7A4A42; color: #D8A39A; }
.btn-danger:hover { background-color: #7A4A42; border-color: #9A6A60; color: #16130E; }

button:disabled { color: #6E6656; border-color: #2A2620; }

/* Utility classes used across the form / list pages. */
.text-center { text-align: center; }
.text-sm { font-size: 14px; }
.text-lg { font-size: 22px; }
.text-secondary { color: #8A8270; }
.mb-md { margin-bottom: 12px; }
.mb-lg { margin-bottom: 24px; }
.mt-md { margin-top: 12px; }
.p-lg { padding: 24px; }

/* Delete-confirmation modal. */
.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(8, 6, 4, 205);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}
/* .modal-overlay's display:flex is defined after .hidden{display:none}, so a plain
   .hidden can't win on equal specificity — make the hidden state explicit for modals. */
.modal-overlay.hidden { display: none; }
.modal {
    width: 440px;
    padding: 26px;
    background-color: #1F1B14;
    border-width: 1px;
    border-color: #3A3326;
    text-align: center;
}
.modal-title { color: #C9A86A; font-size: 24px; font-weight: normal; letter-spacing: 2px; }
.modal-body { margin-top: 12px; margin-bottom: 20px; color: #D8CFBC; }
.modal-footer { display: flex; flex-direction: row; justify-content: center; margin-top: 8px; }
.modal-footer button { margin-left: 8px; margin-right: 8px; }

/* ============================================================================
   World creation (world_creation.rml) — frosted panel, underline fields,
   preset chips, single wide create.
   ============================================================================ */
body#world_creation {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.creation-panel {
    width: 64%;
    max-width: 960px;
    margin: 0 auto;
    padding: 48px 72px 52px;
    text-align: center;
    background-color: rgba(22, 19, 14, 140);
    backdrop-filter: blur(22px);
    border-width: 1px;
    border-color: rgba(242, 237, 228, 28);
    box-shadow: 0px 24px 70px rgba(8, 6, 4, 150);
    border-radius: 2px;
}

#world_creation h1 {
    font-size: 40px;
    letter-spacing: 14px;
    color: #EDE6D8;
    margin: 4px 0 6px;
}

#world_creation .title-ornament { margin-bottom: 34px; }

#world_creation .form-container {
    width: 100%;
    text-align: left;
}

#world_creation .form-group {
    margin-bottom: 28px;
}

#world_creation .form-group label {
    display: block;
    color: #C3B9A2;
    font-size: 13px;
    letter-spacing: 3px;
    margin-bottom: 8px;
}

/* Underline-style inputs. */
#world_creation .form-control {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(242, 237, 228, 70);
    height: 34px;
    font-size: 18px;
    padding: 0;
}
#world_creation .form-control:focus {
    border-bottom-color: #C9A86A;
}

/* Landscape preset chips. */
.preset-row {
    display: flex;
    flex-direction: row;
    margin-top: 4px;
}
.preset-chip {
    flex: 1 1 0;
    height: 42px;
    line-height: 40px;
    margin-right: 10px;
    background-color: rgba(20, 17, 11, 110);
    border-width: 1px;
    border-color: rgba(242, 237, 228, 38);
    color: #C9C0AE;
    font-size: 15px;
    letter-spacing: 2px;
    text-align: center;
}
.preset-chip:last-child { margin-right: 0; }
.preset-chip:hover {
    border-color: #8FA68E;
    color: #F2EDE4;
}
.preset-chip.selected {
    background-color: rgba(143, 166, 142, 70);
    border-color: #B6CBAE;
    color: #F4EFE6;
}

#world_creation #create_btn {
    display: block;
    width: 64%;
    max-width: 400px;
    margin: 0 auto;
    height: 48px;
    line-height: 46px;
    background-color: rgba(20, 17, 11, 110);
    border-width: 1px;
    border-color: rgba(242, 237, 228, 55);
    border-radius: 0;
    backdrop-filter: none;
    box-shadow: none;
    color: #EDE6D8;
    font-size: 15px;
    letter-spacing: 5px;
}
#world_creation #create_btn:hover {
    background-color: rgba(143, 166, 142, 90);
    border-color: #B6CBAE;
    color: #16130E;
    box-shadow: none;
}


body {
    width: 100%;
    height: 100%;
    color: #ffffff;
    font-family: Lora;
    background-color: #1a1a1a;
}

h1 {
    font-size: 96px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
}

p.subtitle {
    text-align: center;
    font-style: italic;
    color: #cccccc;
    font-size: 22px;
}

div#nav {
    text-align: center;
    width: 300px;
    margin-left: auto;
    margin-right: auto;
}

button {
    display: block;
    width: 280px;
    height: 50px;
    margin-bottom: 20px;
    margin-left: auto;
    margin-right: auto;
    background-color: #4f5b66;
    border-width: 2px;
    border-color: #8d99ae;
    color: #ffffff;
    font-size: 20px;
    font-weight: bold;
    font-family: Lora;
    text-align: center;
}

button:hover {
    background-color: #d80032;
    border-color: #ff4d6d;
    color: #ffffff;
}

button:active {
    background-color: #b8002a;
    border-color: #d80032;
    color: #ffffff;
}

.container {
    text-align: center;
    width: 100%;
}

.version-info {
    position: absolute;
    bottom: 16px;
    right: 16px;
    color: #999999;
    font-size: 12px;
}
<rml>
    <head>
        <title>Luminumbra - Main Menu</title>
        <link type="text/css" href="base.rcss" />
        <link type="text/css" href="game_theme.rcss" />
    </head>
    <body id="main_menu" class="fade-in">
        <!-- Main title with quantum effect -->
        <div class="container">
            <h1>luminumbra</h1>
            <p class="subtitle">a world to photograph</p>
            
            <!-- Main navigation -->
            <div id="nav">
                <button id="new_world_btn" class="btn btn-primary">
                    New World
                </button>
                <button id="load_world_btn" class="btn btn-primary">
                    Load World
                </button>
                <button id="settings_btn" class="btn btn-secondary">
                    Settings
                </button>
                <button id="gallery_btn" class="btn btn-secondary">
                    Gallery
                </button>
                <button id="quit_btn" class="btn btn-accent">
                    Quit
                </button>
            </div>
            
            <!-- Version info -->
            <div class="version-info">
                <p class="text-sm text-center">Version 0.1.0 Alpha | Build 2025.08</p>
            </div>
        </div>
        
        <!-- Background particles (CSS animation) -->
        <div class="quantum-background">
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
        </div>
        
        <!-- Notification area -->
        <div id="notification" class="notification hidden">
            <span id="notification_text"></span>
        </div>
    </body>
</rml>

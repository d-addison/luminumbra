body {
    width: 100%;
    height: 100%;
    margin: 0;
    font-family: Lora;
    color: #edf2f4;
}

body#main_menu {
    background-image: /textures/ui/menu_background.png;
    background-fit: cover;
}

h1 {
    font-size: 82px;
    text-align: center;
    margin-top: 15%;
    text-shadow: 2px 2px 8px #111;
    font-weight: bold;
}

p.subtitle {
    text-align: center;
    font-style: italic;
    color: #aaa;
}

div#nav {
    display: block;
    width: 250px;
    margin: 100px auto;
    text-align: center;
}

button {
    display: block;
    width: 100%;
    height: 40px;
    margin-bottom: 15px;
    background-color: #2b2d42aa;
    border: 1px solid #8d99ae;
    color: #edf2f4;
    font-size: 20px;
    cursor: pointer;
}

button:hover {
    border-color: #d80032;
    background-color: #d8003299;
}